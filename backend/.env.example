# Copie para .env e ajuste. O docker-compose já carrega backend/.env (se existir).

# DATABASE_URL, REDIS_URL e RECORDINGS_DIR já são definidos pelo docker-compose.
CORS_ORIGINS=http://localhost:5173

# --- Autenticação ---
# O front atual não tem tela de login. Com AUTH_ENABLED=false toda a API fica aberta
# (use só local; a porta 8000 é publicada apenas em 127.0.0.1 no compose).
AUTH_ENABLED=false
# Obrigatórios quando AUTH_ENABLED=true:
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false

# --- Gravação ---
SEGMENT_SECONDS=30
AUTO_RECORD=true
POLL_INTERVAL_SECONDS=60
STALE_RECORDING_SECONDS=120

# --- Plataformas (detecção de live pelas APIs oficiais) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Autorização de mídia ---
# Serviço SEU/autorizado que devolve uma URL temporária de mídia para um canal ao vivo.
# O back end faz POST {platform, username, channel_id, title} e espera {"media_url": "https://..."}.
# Sem isso, lives são detectadas mas nada é gravado automaticamente.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_TOKEN=
